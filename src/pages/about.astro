---
import MainLayout from "../layouts/main.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { revenueMapFormUrl } from "../lib/conversion-links";
---

<MainLayout
  title="About Said Azizov | Azizov HQ"
  description="Said Azizov is an AI engineer and founder of Azizov HQ, building AI revenue systems for home-service businesses."
  type="profile"
>
  <SiteHeader currentPath={Astro.url.pathname} />
  <main>
    <section class="site-shell about-hero">
      <div class="about-hero__copy">
        <p class="eyebrow">Founder profile</p>
        <h1>Said Azizov.<br /><em>AI engineer.</em></h1>
        <p class="about-hero__lede">I build AI systems that are technically sound, commercially useful, and ready to live inside a real team&apos;s workflow.</p>
        <div class="about-hero__actions">
          <a class="button" href={revenueMapFormUrl}>Map my revenue leaks</a>
          <a class="text-link" href="https://www.linkedin.com/in/said-azizov/" target="_blank" rel="noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="about-hero__image">
        <img src="/images/me.jpg" width="640" height="640" fetchpriority="high" alt="Said Azizov" />
        <figcaption>Founder of Azizov HQ</figcaption>
      </figure>
    </section>

    <section class="site-shell about-proof-strip" aria-label="Selected career proof">
      <div><strong>1M+</strong><span>Model downloads</span><small>X-FLUX ecosystem</small></div>
      <div><strong>4K+</strong><span>GitHub stars</span><small>Open-source AI work</small></div>
      <div><strong>10+</strong><span>Hackathon medals</span><small>National and international competitions</small></div>
    </section>

    <section class="site-shell about-story">
      <div>
        <p class="eyebrow">The through line</p>
        <h2>From model research to systems that <em>move real work.</em></h2>
      </div>
      <div class="about-story__body">
        <p>My background is in deep learning, computer vision, natural language processing, and open-source AI. At SberAI, I worked on the Kandinsky diffusion model. At XLabs AI, I built in the X-FLUX ecosystem.</p>
        <p>That technical foundation matters when a business needs more than a chatbot. The job is to fit AI into lead capture, qualification, CRM, follow-up, team handoff, and the operational habits that already exist.</p>
      </div>
    </section>

    <section class="site-shell about-builds">
      <div class="about-builds__intro">
        <p class="eyebrow">What I build today</p>
        <h2>Revenue infrastructure that helps teams respond, qualify, and follow through.</h2>
      </div>
      <div class="about-builds__list">
        <article><span>01</span><h3>Voice and booking AI</h3><p>Answer inbound calls, qualify demand, and place qualified appointments in the calendar.</p></article>
        <article><span>02</span><h3>Inbox and CRM operations</h3><p>Route messages, keep sales context intact, and stop enquiries dying between teams.</p></article>
        <article><span>03</span><h3>Lead qualification and estimating</h3><p>Use the right data, including images where useful, to focus teams on work worth winning.</p></article>
        <article><span>04</span><h3>Private AI systems</h3><p>Build controlled knowledge and workflow systems for organisations with stronger security requirements.</p></article>
      </div>
    </section>

    <section class="site-shell about-contact">
      <p class="eyebrow">Work with Azizov HQ</p>
      <h2>Start with the bottleneck that costs your team the most.</h2>
      <p>We will map the current journey and identify the system worth building first.</p>
      <a class="button" href={revenueMapFormUrl}>Map my revenue leaks</a>
    </section>
  </main>
  <SiteFooter />
</MainLayout>
