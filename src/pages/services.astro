---
import MainLayout from '../layouts/main.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { services } from '../lib/services';

const catalogOrder = ['chatbots', 'ai-voice-agents', 'custom-ai-agent-development', 'ai-revenue-systems'];
const catalogServices = services
  .filter((service) => service.showInCatalog !== false)
  .sort((a, b) => catalogOrder.indexOf(a.slug) - catalogOrder.indexOf(b.slug));
---
<MainLayout title="AI Automation Services & Starting Prices | Azizov HQ" description="Voice agents, lead qualification and nurturing, custom AI and SaaS development, plus an AI automation audit. See starting rates, delivery timelines, and integrations.">
  <SiteHeader currentPath={Astro.url.pathname} />
  <main>
    <section class="site-shell service-catalog" aria-labelledby="services-heading">
      <header class="service-catalog__heading">
        <p class="eyebrow">Services</p>
        <h1 id="services-heading">AI systems built around the work that matters.</h1>
        <p class="service-catalog__lede">Start with a free audit—or choose a focused system for calls, lead qualification, or the custom product your team needs.</p>
        <p class="service-catalog__note"><span>Plans &amp; scope</span> Starting plans show the core system. Launch work and usage are confirmed before we build.</p>
      </header>
      <div class="service-pricing-grid">
        {catalogServices.map((service) => (
          <article class={`service-price-card service-price-card--${service.slug}`} data-pointer-card>
            <p class="service-price-card__label">{service.pricing.detail}</p>
            <h2>{service.name}</h2>
            <div class="service-price-card__price"><strong>{service.pricing.label}</strong></div>
            {service.pricing.timeline && <p class="service-price-card__timeline">{service.pricing.timeline}</p>}
            <ul>{service.pricing.features.map((feature) => <li>{feature}</li>)}</ul>
            {service.pricing.addOns.length > 0 && (
              <div class="service-price-card__addons">
                <p>{service.pricing.addOnsLabel ?? 'Add-ons'}</p>
                <ul>{service.pricing.addOns.map((addOn) => <li>{addOn}</li>)}</ul>
              </div>
            )}
            {service.deploymentOptions && (
              <div class="service-price-card__options">
                <p>Available channels &amp; integrations</p>
                <ul>{service.deploymentOptions.map((option) => <li>{option}</li>)}</ul>
              </div>
            )}
            {service.complementaryWith && <p class="service-price-card__compatible">Works together: {service.complementaryWith}</p>}
            {service.testimonial && (
              <blockquote class="service-price-card__testimonial">
                <p>“{service.testimonial.cardQuote ?? service.testimonial.quote}”</p>
                <cite><a href={service.testimonial.sourceUrl} target="_blank" rel="noreferrer">{service.testimonial.name}, {service.testimonial.role} ↗</a></cite>
              </blockquote>
            )}
            <div class="service-price-card__footer">
              <p class="service-price-card__terms">{service.pricing.terms}</p>
              {service.supportingLink && <a class="text-link service-price-card__case-link" href={service.supportingLink.href}>{service.supportingLink.label} <span aria-hidden="true">↗</span></a>}
              <div class="service-price-card__actions">
                <a class="button service-price-card__action" href={service.ctaHref ?? `/services/${service.slug}/`} target={service.ctaHref?.startsWith('http') ? '_blank' : undefined} rel={service.ctaHref?.startsWith('http') ? 'noreferrer' : undefined}>{service.ctaLabel ?? 'See details'}</a>
                {service.secondaryCta && <a class="button button--secondary service-price-card__action" href={service.secondaryCta.href} target="_blank" rel="noreferrer">{service.secondaryCta.label}</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter />
</MainLayout>
