---
import MainLayout from '../layouts/main.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { services } from '../lib/services';
---
<MainLayout title="AI Automation Services | Azizov HQ" description="Practical AI systems for calls, messages, inboxes, lead capture, follow-up, and custom agent development.">
  <SiteHeader currentPath={Astro.url.pathname} />
  <main>
    <section class="site-shell service-catalog" aria-labelledby="services-heading">
      <header class="service-catalog__heading">
        <p class="eyebrow">Services</p>
        <h1 id="services-heading">What do you need fixed?</h1>
        <p>Pick the customer bottleneck. We will scope the right system around how your team already works.</p>
      </header>
      <div class="service-pricing-grid">
        {services.map((service) => (
          <article class="service-price-card" data-pointer-card>
            <p class="service-price-card__label">{service.pricing.detail}</p>
            <h2>{service.name}</h2>
            <div class="service-price-card__price"><strong>{service.pricing.label}</strong></div>
            <ul>{service.pricing.features.map((feature) => <li>{feature}</li>)}</ul>
            <a class="button button--secondary service-price-card__action" href={`/services/${service.slug}/`}>See details</a>
          </article>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter />
</MainLayout>
