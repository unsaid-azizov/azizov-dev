---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/main.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import { FlickeringGrid } from "../components/ui/flickering-grid";
import { bookingCalendarUrl, revenueMapFormUrl } from "../lib/conversion-links";
import { services } from "../lib/services";

const homepageOfferOrder = ["ai-revenue-systems", "chatbots", "ai-voice-agents", "custom-ai-agent-development"];
const homepageOffers = services
  .filter((service) => homepageOfferOrder.includes(service.slug))
  .sort((a, b) => homepageOfferOrder.indexOf(a.slug) - homepageOfferOrder.indexOf(b.slug));

const testimonialOrder = ["enrico-2", "malik-linkedin", "mike-repara"];
const testimonials = (await getCollection("testimonials"))
  .filter((testimonial) => testimonialOrder.includes(testimonial.id))
  .sort((a, b) => testimonialOrder.indexOf(a.id) - testimonialOrder.indexOf(b.id))
  .map((testimonial) => ({
    ...testimonial,
    quote: testimonial.body.trim().replace(/\[([^\]]+)\]\([^\)]+\)/g, "$1"),
  }));

const caseStudies = (await getCollection("caseStudies"))
  .filter((caseStudy) => caseStudy.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<MainLayout
  title="Azizov HQ — AI Systems That Move Work Forward"
  description="Azizov HQ helps service and operational businesses capture demand, qualify leads, and build AI systems around the work that matters."
>
  <SiteHeader currentPath={Astro.url.pathname} />
  <main>
    <section class="site-shell hero-sales">
      <div class="hero-sales__field" aria-hidden="true">
        <FlickeringGrid client:visible className="hero-sales__flicker" squareSize={2} gridGap={7} flickerChance={0.09} color="#dfff9d" maxOpacity={0.52} />
        <span></span>
      </div>
      <div class="hero-sales__copy">
        <p class="eyebrow">AI systems for growing businesses</p>
        <h1>Turn customer demand into <em>clear next steps.</em></h1>
        <p class="hero-sales__lede">From calls and lead qualification to custom systems, Azizov HQ builds AI that helps your team respond faster, keep context, and move the right work forward.</p>
        <div class="hero-sales__actions">
          <a class="button" href={revenueMapFormUrl} target="_blank" rel="noreferrer">Map revenue leaks</a>
          <a class="button button--secondary" href="#services">See the systems</a>
        </div>
      </div>
      <dl class="hero-sales__proof" aria-label="Selected deployment outcomes">
        <div><dt>Additional work captured</dt><dd>~£10K</dd><small>Ekron Surveyors in the first 3 months</small></div>
        <div><dt>Operating-cost reduction</dt><dd>83%</dd><small>Voice-agent deployment</small></div>
        <div><dt>Qualified demand handled</dt><dd>100+</dd><small>Leads per day, MIX-STROY workflow</small></div>
      </dl>
    </section>

    <section class="site-shell founder-preview homepage-founder" aria-labelledby="founder-preview-title">
      <div class="founder-preview__portrait">
        <img src="/images/me.jpg" width="640" height="640" loading="lazy" decoding="async" alt="Said Azizov, founder of Azizov HQ" />
      </div>
      <div class="founder-preview__copy">
        <p class="eyebrow">About me</p>
        <h2 id="founder-preview-title">Engineering depth, applied to <em>work that matters.</em></h2>
        <p>I’m Said Azizov, an AI engineer and technical partner. I combine research and product experience with hands-on work in the calls, messages, CRM, and internal systems your team relies on every day.</p>
        <a class="text-link" href="/about/">Meet Said <span aria-hidden="true">↗</span></a>
      </div>
      <dl class="founder-preview__proof" aria-label="Founder background">
        <div><dt>Production AI</dt><dd>SberAI and Kandinsky</dd></div>
        <div><dt>Open source</dt><dd>1M+ model downloads</dd></div>
        <div><dt>Today</dt><dd>Direct technical partnership</dd></div>
      </dl>
    </section>

    <section class="site-shell homepage-offers" id="services" aria-labelledby="services-heading">
      <div class="homepage-section-heading">
        <p class="eyebrow">Choose the starting point</p>
        <h2 id="services-heading">Start with the workflow that is costing you the most.</h2>
        <p>Not sure which system fits? Begin with a free roadmap. If you already know the problem, choose the service and see exactly what it covers.</p>
      </div>
      <div class="homepage-offers__grid">
        {homepageOffers.map((service) => (
          <article class={`homepage-offer homepage-offer--${service.slug}`}>
            <p>{service.pricing.detail}</p>
            <h3>{service.name}</h3>
            <strong>{service.pricing.label}</strong>
            {service.pricing.timeline && <small>{service.pricing.timeline}</small>}
            <ul>{service.pricing.features.map((feature) => <li>{feature}</li>)}</ul>
            {service.pricing.addOns.length > 0 && (
              <div class="homepage-offer__addons">
                <p>{service.pricing.addOnsLabel ?? "Add-ons"}</p>
                <ul>{service.pricing.addOns.map((addOn) => <li>{addOn}</li>)}</ul>
              </div>
            )}
            {service.deploymentOptions && (
              <div class="homepage-offer__options">
                <p>Available channels &amp; integrations</p>
                <ul>{service.deploymentOptions.map((option) => <li>{option}</li>)}</ul>
              </div>
            )}
            {service.complementaryWith && <p class="homepage-offer__compatible">Works together: {service.complementaryWith}</p>}
            <div class="homepage-offer__footer">
              <p>{service.pricing.terms}</p>
              <div class="homepage-offer__actions">
                {service.secondaryCta && <a class="button button--secondary" href={service.secondaryCta.href} target="_blank" rel="noreferrer">{service.secondaryCta.label}</a>}
                <a class="button" href={service.ctaHref ?? `/services/${service.slug}/`} target={service.ctaHref?.startsWith("http") ? "_blank" : undefined} rel={service.ctaHref?.startsWith("http") ? "noreferrer" : undefined}>{service.ctaLabel ?? "See details"}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="site-shell homepage-testimonials" id="testimonials" aria-labelledby="testimonials-heading">
      <div class="homepage-section-heading">
        <p class="eyebrow">Client trust</p>
        <h2 id="testimonials-heading">Proof from people who have worked with me.</h2>
      </div>
      <div class="google-review-summary">
        <div><p>Google Business Profile</p><strong>5.0 <span aria-label="Five out of five stars">★★★★★</span></strong><small>Based on 5 Google reviews</small></div>
        <p>Independent feedback from clients on AI automation and consulting work.</p>
        <a class="button button--secondary" href="https://share.google/vx0zjYpxFOi7YCuI3" target="_blank" rel="noreferrer">Read Google reviews</a>
      </div>
      <div class="homepage-testimonials__grid">
        {testimonials.map((testimonial) => (
          <article>
            <p class="homepage-testimonials__stars" aria-label={`${testimonial.data.rating} out of 5 stars`}>{"★".repeat(testimonial.data.rating)}</p>
            <blockquote>“{testimonial.quote}”</blockquote>
            <footer>
              <strong>{testimonial.data.clientName}</strong>
              <span>{[testimonial.data.role, testimonial.data.company].filter(Boolean).join(" · ")}</span>
              {testimonial.data.sourceUrl && <a class="text-link" href={testimonial.data.sourceUrl} target="_blank" rel="noreferrer">View source <span aria-hidden="true">↗</span></a>}
            </footer>
          </article>
        ))}
      </div>
    </section>

    <section class="site-shell homepage-proof" aria-labelledby="proof-heading">
      <div class="section-heading-stack">
        <div><p class="eyebrow">Selected systems</p><h2 class="section-title" id="proof-heading">The proof is in the operational detail.</h2></div>
        <a class="text-link" href="/case-studies/">See all case studies <span aria-hidden="true">↗</span></a>
      </div>
      <div class="case-grid">
        {caseStudies.map((caseStudy) => <CaseStudyCard slug={caseStudy.id} client={caseStudy.data.client} industry={caseStudy.data.industry} title={caseStudy.data.title} result={caseStudy.data.result} engagement={caseStudy.data.engagement} metrics={caseStudy.data.metrics} />)}
      </div>
    </section>

    <section class="site-shell audit-banner homepage-cta">
      <div>
        <p class="eyebrow">Start with the roadmap</p>
        <h2>Get a useful AI roadmap before you pay for a deeper audit.</h2>
        <p>Tell me how your leads and work move today. I’ll review the process and send a personalized first step for your business.</p>
      </div>
      <a class="button" href={revenueMapFormUrl} target="_blank" rel="noreferrer">Map revenue leaks</a>
    </section>
  </main>
  <SiteFooter />
</MainLayout>
