---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/main.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, pageTitle, description, category, tags, date, result, link, language } = post.data;

const isRussian = language === "ru";
const locale = isRussian ? "ru-RU" : "en-US";
const ui = isRussian
  ? {
      allInsights: "Все статьи",
      relatedHeading: "Читайте также",
      readInsight: "Читать статью ↗",
      topics: "Темы",
    }
  : {
      allInsights: "All insights",
      relatedHeading: "Keep reading",
      readInsight: "Read insight ↗",
      topics: "Topics",
    };

const categoryLabels: Record<string, string> = {
  hackathon: "Hackathon",
  award: "Award",
  talk: "Talk",
  publication: "Publication",
  article: isRussian ? "Статья" : "Article",
};

const formattedDate = date.toLocaleDateString(locale, {
  month: "long",
  day: "numeric",
  year: "numeric",
});

// Older posts use long dashes in titles and summaries. Keep the original source
// content intact while presenting the current HQ punctuation in the template.
const displayText = (value: string) => value.replace(/[—–]/g, "-");

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// BlogPosting structured data for rich results
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  url: canonical,
  author: {
    "@id": "https://azizovhq.com/about/#person",
  },
  publisher: {
    "@id": "https://azizovhq.com/#organization",
  },
  image: new URL(`/og/${post.id}.png`, Astro.site).href,
  keywords: tags.join(", "),
  inLanguage: language,
  mainEntityOfPage: canonical,
};

// Get related posts (same category, excluding current)
const allPosts = (await getCollection("blog"))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const relatedPosts = allPosts
  .filter((p) => p.data.category === category || p.data.tags.some((t) => tags.includes(t)))
  .slice(0, 3);
---

<MainLayout title={`${pageTitle ?? title} | Said Azizov`} description={description} type="article" image={`/og/${post.id}.png`} lang={language}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <SiteHeader currentPath={Astro.url.pathname} />
  <main class="article-page">
    <article class="site-shell article-layout">
    <header class="article-hero">
      <div class="article-hero__meta">
        <a href="/blog/">{ui.allInsights}</a>
        <span>{categoryLabels[category]}</span>
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </div>

      <h1>{displayText(title)}</h1>
      <p class="article-hero__summary">{displayText(description)}</p>

      {result && <p class="article-hero__result">{displayText(result)}</p>}

      {link && (
        <a class="article-source" href={link} target="_blank" rel="noopener noreferrer">
          Open source <b>↗</b>
        </a>
      )}
    </header>

    <div class="article-content-grid">
      <aside class="article-rail">
        <p>{ui.topics}</p>
        <ul>
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </aside>

      <div class="prose-custom article-prose">
        <Content />
      </div>
    </div>

    {relatedPosts.length > 0 && (
      <section class="article-related" aria-labelledby="related-heading">
        <h2 id="related-heading">{ui.relatedHeading}</h2>
        <div class="article-related__list">
          {relatedPosts.map((related) => (
            <a href={`/blog/${related.id}/`}>
              <span>
              {categoryLabels[related.data.category]} · {related.data.date.toLocaleDateString(locale, { month: "short", year: "numeric" })}
              </span>
              <h3>{displayText(related.data.title)}</h3>
              <b>{ui.readInsight}</b>
            </a>
          ))}
        </div>
      </section>
    )}
    </article>
  </main>
  <SiteFooter />
</MainLayout>
