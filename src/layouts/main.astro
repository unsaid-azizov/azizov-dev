---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
}

const { 
  title, 
  description = "Azizov HQ builds AI revenue systems that turn inbound demand into qualified, booked, profitable work for home-service businesses.",
  image = "/images/me.jpg",
  type = "website"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// Breadcrumb structured data from URL path
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href }
];
let cumulativePath = "";
for (let i = 0; i < pathSegments.length; i++) {
  cumulativePath += `/${pathSegments[i]}`;
  breadcrumbItems.push({
    "@type": "ListItem",
    position: i + 2,
    name: i === pathSegments.length - 1 ? title.split(" | ")[0] : pathSegments[i].charAt(0).toUpperCase() + pathSegments[i].slice(1),
    item: new URL(cumulativePath + "/", Astro.site).href,
  });
}
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};

const siteUrl = "https://azizovhq.com";
const organizationId = `${siteUrl}/#organization`;
const personId = `${siteUrl}/about/#person`;
const serviceCatalog = [
  ["Free AI Workflow Audit", "ai-revenue-systems"],
  ["AI Voice Agents", "ai-voice-agents"],
  ["Lead Qual and nurturing", "chatbots"],
  ["Custom Agent & SaaS Development", "custom-ai-agent-development"],
].map(([name, slug]) => ({
  "@type": "Offer",
  name,
  url: `${siteUrl}/services/${slug}/`,
  itemOffered: { "@type": "Service", name, url: `${siteUrl}/services/${slug}/` },
}));

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  name: "Azizov HQ",
  alternateName: "Said Azizov",
  url: siteUrl,
  description: "AI revenue systems for home-service businesses.",
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: "Azizov HQ",
  url: siteUrl,
  email: "said@azizovhq.com",
  description: "Azizov HQ builds AI revenue systems for home-service businesses, including lead capture, qualification, estimating, CRM, follow-up, and reactivation.",
  founder: { "@id": personId },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email: "said@azizovhq.com",
    availableLanguage: "English",
  },
  knowsAbout: [
    "AI revenue systems",
    "Lead qualification",
    "AI receptionists",
    "CRM automation",
    "Sales follow-up automation",
    "Private AI systems",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Azizov HQ services",
    url: `${siteUrl}/services/`,
    itemListElement: serviceCatalog,
  },
};

const PERSON_BIO = "AI engineer and founder of Azizov HQ. Said builds AI revenue systems for businesses and has a background in deep learning, computer vision, NLP, and open-source AI.";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  name: "Said Azizov",
  jobTitle: "Founder and AI Engineer",
  description: PERSON_BIO,
  url: `${siteUrl}/about/`,
  email: "said@azizovhq.com",
  image: `${siteUrl}/images/me.jpg`,
  sameAs: [
    "https://github.com/unsaid-azizov",
    "https://www.linkedin.com/in/said-azizov/",
    "https://huggingface.co/stazizov",
    "https://x.com/said_azizow",
    "https://t.me/astex_channel",
    "https://www.instagram.com/said.azizow/",
    "https://scholar.google.com/citations?user=ueDU47EAAAAJ&hl=en",
    "https://www.youtube.com/@said_azizov",
    "https://www.upwork.com/freelancers/azizov"
  ],
  knowsAbout: [
    "AI Agents",
    "Voice Agents",
    "Deep Learning",
    "Neural Networks",
    "Computer Vision",
    "Natural Language Processing",
    "Diffusion Models",
    "Business Process Automation",
    "AI Product Development",
    "LangChain",
    "MCP Protocol",
    "On-Premise LLM Deployment"
  ],
  worksFor: { "@id": organizationId },
  alumniOf: { "@type": "CollegeOrUniversity", name: "NUST MISIS" },
  identifier: [
    {
      "@type": "PropertyValue",
      propertyID: "Google Scholar",
      value: "ueDU47EAAAAJ",
      url: "https://scholar.google.com/citations?user=ueDU47EAAAAJ"
    },
    {
      "@type": "PropertyValue",
      propertyID: "HuggingFace",
      value: "stazizov",
      url: "https://huggingface.co/stazizov"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		
		{/* Primary Meta Tags */}
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Said Azizov, Azizov HQ" />
		<link rel="canonical" href={canonical} />
		<link rel="preconnect" href="https://www.loom.com" />
		<link rel="preconnect" href="https://cdn.loom.com" crossorigin />
		<link rel="dns-prefetch" href="https://cdn.loom.com" />
		
		{/* Sitemap discovery */}
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

		{/* Webmaster Verification */}
		<meta name="msvalidate.01" content="DFDBA5981283271DE05A2F7B5CD8B1A4" />
		
		{/* Open Graph / Facebook */}
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:site_name" content="Azizov HQ" />
		<meta property="og:locale" content="en_US" />
		
		{/* Twitter / X */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:creator" content="@said_azizow" />
		<meta name="twitter:site" content="@said_azizow" />
		
		{/* Additional meta for LLM understanding */}
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="theme-color" content="#0a0a0a" />
		
		{/* Structured Data (JSON-LD) */}
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		{breadcrumbItems.length > 1 && (
			<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		)}
		
		{/* Favicon */}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<link rel="alternate icon" href="/favicon.ico?v=3" sizes="32x32" />
		
	</head>
	<body>
		<slot />
		<script>
			for (const card of document.querySelectorAll<HTMLElement>("[data-pointer-card]")) {
				card.addEventListener("pointermove", (event) => {
					const bounds = card.getBoundingClientRect();
					card.style.setProperty("--pointer-x", `${((event.clientX - bounds.left) / bounds.width) * 100}%`);
					card.style.setProperty("--pointer-y", `${((event.clientY - bounds.top) / bounds.height) * 100}%`);
				});
			}
		</script>
	</body>
</html>
