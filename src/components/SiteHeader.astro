---
const { currentPath = "" } = Astro.props;
import { bookingCalendarUrl, revenueMapFormUrl } from "../lib/conversion-links";

const navigation = [
  { href: "/services/", label: "Services" },
  { href: "/solutions/", label: "Solutions" },
  { href: "/case-studies/", label: "Case studies" },
  { href: "/blog/", label: "Insights" },
  { href: "/about/", label: "About" },
];
---

<header class="site-header">
  <div class="site-shell site-header__inner">
    <a class="brand" href="/" aria-label="Azizov HQ home"><span class="brand__name">Azizov</span><span class="brand__hq">HQ</span></a>
    <nav class="site-nav" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={currentPath.startsWith(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="site-header__actions">
      <a class="button button--compact button--secondary" href={bookingCalendarUrl}>Book a call</a>
      <a class="button button--compact" href={revenueMapFormUrl}>Map revenue leaks</a>
    </div>
  </div>
</header>
